#!/usr/bin/env bash
# Entry point to the loop at tools/openspec-loop/ (#357).
#
# Callers: CI, .claude/commands/*, .claude/hooks/review-gate.sh.
# Not the git hooks: they run from tools/openspec-loop/.githooks and call ../workflow.
#
# Arguments and exit status pass through unchanged.
set -euo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "loop: not inside a git repository." >&2; exit 2; }
kit="$root/tools/openspec-loop/workflow"

usage() {
  cat >&2 <<'USAGE'
usage: .workflow/loop <command> [args...]

  change         run one accepted issue end to end on four named agents
  apply          implement on one agent, review on another
  stage          run a single stage
  review-gate    the plan and diff review gate (--probe, --plan-only pass through)
  archive-check  the archive-is-the-delta gate
  merge-shape    refuse a merge anywhere but main
  digest         write or print a change's specs digest
  detach         launch a long run in its own session
  setup          point git at the vendored hooks
  test           run the three suites
USAGE
}

[ "$#" -gt 0 ] || { usage; exit 2; }
cmd="$1"; shift

case "$cmd" in
  change)        script=run-change.sh ;;
  apply)         script=apply.sh ;;
  stage)         script=run-stage.sh ;;
  review-gate)   script=review-gate-check.sh ;;
  archive-check) script=archive-merge-check.sh ;;
  merge-shape)   script=merge-shape-check.sh ;;
  digest)        script=specs-digest.sh ;;
  detach)        script=detach.sh ;;
  setup)         script=setup-hooks.sh ;;
  test)
    rc=0
    for s in gate-tests.sh apply-tests.sh change-tests.sh; do
      [ -x "$kit/$s" ] || { echo "loop: $kit/$s is missing." >&2; exit 2; }
      "$kit/$s" || rc=1
    done
    exit "$rc" ;;
  -h|--help)     usage; exit 0 ;;
  *)             echo "loop: unknown command '$cmd'" >&2; usage; exit 2 ;;
esac

[ -d "$kit" ] || {
  echo "loop: $kit is missing. The loop is a git subtree at tools/openspec-loop/;" >&2
  echo "loop: a checkout without it is incomplete, not un-installed." >&2
  exit 2; }
[ -x "$kit/$script" ] || { echo "loop: $kit/$script is missing or not executable." >&2; exit 2; }

exec "$kit/$script" "$@"
