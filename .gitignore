/target
**/*.rs.bk

# Local dev config dir (LABELER_CONFIG_DIR=./config-dev): DB + templates + assets
/config-dev/

*.pdf
*.db

# Engine-upgrade visual-comparison dumps (dump_all_template_renders)
/.render-scratch/

ui/node_modules
ui/dist

# Superpowers scratch: brainstorm specs, implementation plans, SDD ledgers (CLAUDE.md)
/docs/superpowers/
/.superpowers/

# Git worktrees
/.worktrees/

# Per-machine Claude Code permissions (the rest of .claude/ is committed)
/.claude/settings.local.json

# Project instructions live in this repo, not in a personal dotfiles symlink (#178).
# AGENTS.md is the canonical file; CLAUDE.md is a symlink to it (#179).
# A global gitignore matches both names; these negations override it here.
!/CLAUDE.md
!/AGENTS.md

# Personal, machine-specific instructions. Loaded alongside CLAUDE.md, never committed.
/CLAUDE.local.md

# Agent run artifacts: logs, raw transcripts and resume ids, written by
# .workflow/run-stage.sh into the worktree it runs in (#255).
.agent-runs/

# Machine-local agent lineup for run-change.sh and apply.sh (#330). Which CLIs are
# installed and authenticated is a property of this machine, not of labeler, so this
# never arrives by checkout the way repo policy does.
/.workflow/roles.local

# The blocking-question protocol (#283): a stage that cannot decide something writes
# QUESTIONS.md at its worktree root and stops, and the answers come back beside it.
# Working state, never record: what a question settled belongs in the plan.
/QUESTIONS.md
/ANSWERS.md
