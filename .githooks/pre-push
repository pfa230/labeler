#!/usr/bin/env bash
# Refuse pushes while an apply is running in the worktree being pushed from (#294).
#
# This worktree's lock, not the repository's: --git-dir is per worktree where
# --git-common-dir is shared. Keyed on the shared one, a finished and reviewed change
# could not be pushed because an unrelated agent was writing in another tree, which is
# what happened to #285 while #235 was mid-review.
set -euo pipefail
lock="$(git rev-parse --path-format=absolute --git-dir)/APPLY_IN_PROGRESS"
[ -f "$lock" ] || exit 0
echo "apply-lock: an apply is in progress here ($(cat "$lock"))." >&2
echo "apply-lock: nothing leaves this machine mid-apply." >&2
exit 1
