#!/usr/bin/env bash
# Refuse a merge while an apply owns one of the trees it touches (#294, #316). git does
# not run pre-commit for merge commits, so this is the separate hook that covers them.
#
# Two per-worktree checks, and nothing wider. The lock is keyed per worktree, so a merge
# asks about the two trees it actually involves: the one it lands in, and the one holding
# what is being landed. Both are asked of git's own registry - the worktree list, then
# that worktree's git dir - rather than by globbing .worktrees/ in the checkout. That
# convention is where this repo puts them, not where git requires them, and a hook that
# only sees the convention stops protecting the tree that departs from it.
#
# It was repository-wide until #316, refusing on ANY held lock. That stopped a finished,
# reviewed, CI-green change from merging because an unrelated agent was writing in another
# tree, which is the defect #294 was filed on, left standing in the one path #294 exempted
# from its own fix. The argument recorded for the exemption - a merge into main happens in
# a different worktree from the one being written, so a per-worktree lock would never see
# it - holds only against a lock read from the CURRENT tree, which is how pre-commit and
# pre-push read it. MERGE_HEAD names the commits being merged, and git maps those to the
# tree that holds them, so the case the exemption was for is reached without the "any".
#
# It does not run at all for a fast-forward, which creates no commit to hook (#317).
#
# Since #341 it carries a second refusal: a change branch rebases onto main and never
# merges into itself. Both duties belong here for the same reason, which is that git splits
# a merge commit across two hooks and this is the half pre-commit never sees.
set -euo pipefail

refuse() { # refuse <lock> <whose>
  echo "apply-lock: an apply is in progress $2 ($(cat "$1"))." >&2
  echo "apply-lock: merging is not part of the apply stage. Wait for it to finish, review the diff, then integrate deliberately." >&2
  echo "apply-lock: git has already staged this merge and left MERGE_HEAD behind. Run 'git merge --abort' now to clear it." >&2
  exit 1
}

mine=$(git rev-parse --path-format=absolute --git-dir)
if [ -f "$mine/APPLY_IN_PROGRESS" ]; then
  refuse "$mine/APPLY_IN_PROGRESS" "here"
fi

# After this tree's lock and before the MERGE_HEAD guard below, which exits 0 (#341). The
# order matches pre-commit's, where the lock is also asked first, so the same attempt gets
# the same answer whichever hook git happens to run. It cannot go after the guard: git has
# not written MERGE_HEAD when it runs this hook, so everything past that line is already
# unreachable on the path this refusal exists for.
#
# Found beside this hook rather than under the repository root: change-tests.sh runs this
# hook by path against a throwaway repo that has no .workflow of its own, so a root-relative
# lookup would exit 127 there and a suite would assert against a hook that never ran.
"$(dirname "$0")/../.workflow/merge-shape-check.sh"

# Staged but uncommitted, which is where this hook runs, so MERGE_HEAD is the merge in
# hand. It holds one line per commit being merged, so an octopus is read as written.
merge_head=$(git rev-parse --path-format=absolute --git-path MERGE_HEAD)
[ -f "$merge_head" ] || exit 0

while read -r sha; do
  [ -n "$sha" ] || continue
  path=""
  while IFS= read -r line; do
    case $line in
      "worktree "*) path=${line#worktree } ;;
      "HEAD $sha")
        held=$(git -C "$path" rev-parse --path-format=absolute --git-dir)/APPLY_IN_PROGRESS
        [ -f "$held" ] && refuse "$held" "in $path, which holds what you are merging"
        ;;
    esac
  done < <(git worktree list --porcelain)
done < "$merge_head"
